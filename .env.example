NEXT_PUBLIC_WP_GRAPHQL_URL=http://headless-test.local/graphql
WP_AUTH_USER=your-wp-username
WP_AUTH_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx-xxxx
WP_PREVIEW_SECRET=any-secret-string-you-choose
# Adobe Fonts (Typekit) kit ID — found in the embed code URL: use.typekit.net/{kitId}.js
# Leave blank to disable Typekit loading entirely.
NEXT_PUBLIC_TYPEKIT_ID=
# Multisite: optional JSON array mapping request hosts to per-site GraphQL endpoints.
# Supports subdomain, subdirectory, and separate-domain topologies.
# Example: [{"host":"site-a.example.com","graphql":"http://site-a.local/graphql"},{"host":"site-b.example.com","graphql":"http://site-b.local/graphql"}]
# Leave unset for single-site installs.
NEXT_PUBLIC_WP_SITES=

# ─── Revalidation webhook (inbound from WordPress) ────────────────────────────
# Shared secret for POST /api/revalidate. Must match TIMBERLAND_REVALIDATE_SECRET
# in wp-config.php, and must be at least 32 characters — the WP side refuses to
# send otherwise.
WP_REVALIDATE_SECRET=

# ─── Absolute site origin (JSON-LD) ──────────────────────────────────────────
# schema.org url/item values must be absolute. Every other absolute URL in this
# app is taken from the request (sitemap, robots.txt), but JSON-LD renders
# inside the page, and reading headers() there would make every page dynamic
# and undo static generation. So this one comes from config.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, then localhost:3000.
NEXT_PUBLIC_SITE_URL=
