# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Base URL of the WordPress site that serves design tokens.
# When set, `npm run sync-tokens` (and the prebuild/predev hooks) will fetch
# /wp-json/timberland/v1/design-tokens and write
# src/scss/non-printing/_synced.generated.scss.
TIMBERLAND_API_URL=http://natural-rose.local

# Set to false to disable token sync in environments without WP access (e.g. CI).
# SYNC_TOKENS=false
